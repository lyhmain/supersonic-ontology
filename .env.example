# Doris(MySQL 协议)
DORIS_HOST=127.0.0.1
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASS=
DORIS_DB=dw

# SuperSonic(可选,仅 /api/plugin 健康检查与语义对拍用)
SUPERSONIC_BASE=http://127.0.0.1:9080
SUPERSONIC_USER=admin
SUPERSONIC_PASS=

# 洞察 LLM(OpenAI 兼容;也可在 /ui 的 Jev 后端页配置)
GLM_BASE=http://127.0.0.1:8000/v1
GLM_KEY=
GLM_MODEL=qwen2.5-7b-instruct

# 本体
ONTOLOGY_PROFILE=demo_tea
ONTOLOGY_DIR=/app/profiles
JEV_CONFIG=/app/data/jev_config.json

# ====================
# 知识库(RAG)外挂通道(可选):kb_rag 服务地址
# ====================
KB_ENABLED=false
KB_API_BASE=http://127.0.0.1:9200
KB_TIMEOUT=90

# 服务端口(默认 9102;同机多实例时改这里)
PORT=9102

# ====================
# 知识库插件(kb_rag)—— JEV+RAG 全量配置(默认问数插件不启动它)
# ====================
# LLM(生成/门控,OpenAI 兼容;不填则回落 GLM_BASE)
LLM_API_BASE=
LLM_API_KEY=
LLM_DEFAULT_MODEL=GLM-5.3-Flash
# Embedding(OpenAI 兼容)
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBED_BATCH_SIZE=8
# Milvus 向量库
MILVUS_URL=
MILVUS_USER=root
MILVUS_PASSWORD=
# MinIO(原文件存储)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base
# PostgreSQL(会话历史)
PG_HOST=
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=kb_rag
# 可选:VL 多模态 / MinerU 高保真 PDF / 联网搜索(默认关闭)
VL_API_BASE=
VL_API_KEY=
VL_MODEL=
MINERU_API_TOKEN=
